{
  "name": "pointerviz",
  "version": "2.2.1",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:instructor": "vite --mode instructor",
    "build": "vite build",
    "build:instructor": "vite build --mode instructor --outDir dist-instructor",
    "check:editions": "node scripts/check-editions.mjs",
    "screenshots:tutorial": "node scripts/tutorial-screenshots.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "test": "node --test \"test/*.test.js\"",
    "test:core": "node --test test/core.test.js",
    "test:integration": "node --test test/roundtrip.test.js",
    "test:layout": "node --test test/layout.test.js",
    "test:flow-integration": "node --test test/flow-integration.test.js",
    "test:playback": "node --test test/playback.test.js",
    "test:semantics": "node --test test/c-semantics.test.js",
    "test:addresses": "node --test test/addresses.test.js",
    "test:native": "node --test test/native-c.test.js",
    "audit:n3088": "node test/audit-n3088.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-tree-sitter": "^0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "vite": "^8.3.1"
  }
}
